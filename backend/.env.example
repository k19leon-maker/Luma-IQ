# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5174

# Database
DATABASE_URL=postgresql://psy_boost:psy_boost_secret@localhost:5432/psy_boost
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=dev_jwt_secret_change_in_prod
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# AI APIs (leave empty to use mock mode)
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_MODEL=gpt-5.4
AI_MODEL_SOL=gpt-5.6-sol
AI_MODEL_TERRA=gpt-5.6-terra
AI_MODEL_LUNA=gpt-5.6-luna
AI_MODEL_TRANSCRIBE_MINI=gpt-4o-mini-transcribe
AI_MODEL_TRANSCRIBE_DIARIZE=gpt-4o-transcribe-diarize
OPENAI_B2C_PSYCHOLOGY_API_KEY=
OPENAI_B2C_PSYCHOLOGY_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

AI_ORCHESTRATION_V2=false
AI_ORCHESTRATION_V2_ACTIONS=
# Comma-separated user UUIDs/emails. Admin users are always eligible when the flag and action allowlist are enabled.
AI_ORCHESTRATION_V2_USERS=
# Deterministic percentage for ordinary users. Explicit users and admins bypass this percentage.
AI_ORCHESTRATION_V2_ROLLOUT_PERCENT=0
AI_POINTS_V2=false
AI_ROUTER_V2=false
AI_BATCH_ENABLED=false
AI_COST_RECONCILIATION=false
AI_ADMIN_ECONOMICS_V2=false
# Emergency rollback control. Keep true until V2 is stable at 100%.
AI_LEGACY_RUNTIME_ENABLED=true
AI_POINT_SWEEPER_INTERVAL_MINUTES=15
AI_POINT_STALE_MINUTES=45
AI_V2_ALERT_MIN_RUNS=10
AI_V2_MAX_ERROR_RATE=0.1
AI_V2_MAX_P90_COST_PER_POINT_USD=0.002
GEMINI_API_KEY=
GROK_API_KEY=

# Telegram Bot Platform (test mode is safe by default)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_SPREADSHEET_ID=1CoVzhoI_ZZkL23Mtfg6PE6bzEKH_d-e3Fzp6a-xJbmg
TELEGRAM_BOT_TEST_MODE=true
TELEGRAM_BOT_TEST_USER_IDS=
TELEGRAM_BOT_SCHEDULER_INTERVAL_MS=30000

# B2C SEO research: Yandex Wordstat -> Google Sheets
YANDEX_SEARCH_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
SEO_SPREADSHEET_ID=1YOltPlAxNurdYDzMKrVV2zpTfxEvUa4_DEA6viWa8J8
# Prefer a JSON key file outside git. Base64 is supported for secret managers.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/app/backend/secrets/google-sheets-service-account.json
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_BASE64=
WORDSTAT_MAX_SEEDS_PER_RUN=5
WORDSTAT_MAX_COST_RUB_PER_RUN=10
WORDSTAT_TOP_PHRASES=100
WORDSTAT_INCLUDE_REGIONS=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@lumaiq.ru

# YooKassa (disabled by default for pilot mode)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_ENABLED=false
YOOKASSA_RETURN_URL=http://localhost:5174/settings?tab=subscription

# Pilot/admin controls
REGISTRATION_ENABLED=false
MANUAL_ADMIN_SECRET=
FREE_AI_DAILY_LIMIT=5

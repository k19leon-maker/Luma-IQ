generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  name           String?
  avatarUrl      String?
  googleId       String?  @unique
  role           Role     @default(USER)
  isVerified     Boolean  @default(false)
  avatarColor    String?  @default("#7c6cfc")
  defaultAiModel String?  @default("chatgpt")
  specialization String?
  onboardingStatus      String   @default("not_started")
  onboardingStep        Int      @default(0)
  onboardingVersion     String   @default("b2b_v1")
  onboardingCompletedAt DateTime?
  onboardingData        Json?
  recommendedRoute      String?
  createdProjectId      String?
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  refreshTokens       RefreshToken[]
  sessions            Session[]
  projects            Project[]
  verificationTokens  VerificationToken[]
  subscription        Subscription?
  payments            Payment[]
  aiUsage             AIUsage[]
  events              UserEvent[]
  aiRequestLogs       AIRequestLog[]
  billingPeriods      BillingPeriod[]
  creditLedgerEntries CreditLedgerEntry[]
  aiGenerations       AIGeneration[]
  aiUsageEvents       AIUsageEvent[]
  featureUsageDaily   FeatureUsageDaily[]
  aiWorkflowRuns      AIWorkflowRun[]
  aiArtifacts         AIArtifact[]
  structuredOutputs   ProjectStructuredOutput[]
  projectFiles        ProjectFile[]
  projectTasks        ProjectTask[]
  castDevRecords      CastDevRecord[]
  promptVersions      PromptVersion[]
  promptExperiments   PromptExperiment[]
  consentLogs         ConsentLog[]

  @@index([archivedAt])
  @@map("users")
}

model ConsentLog {
  id                   String   @id @default(uuid())
  userId               String?
  email                String?
  ip                   String?
  userAgent            String?
  privacyAccepted      Boolean  @default(false)
  personalDataAccepted Boolean  @default(false)
  offerAccepted        Boolean  @default(false)
  documentVersion      String
  source               String?
  acceptedAt           DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, acceptedAt])
  @@index([email, acceptedAt])
  @@index([documentVersion])
  @@map("consent_logs")
}

model B2CSession {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  email             String?
  phone             String?
  profile           Json?
  diagnosticAnswers Json?
  clientData        Json?
  expiresAt         DateTime
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages B2CChatMessage[]

  @@index([expiresAt])
  @@index([email, updatedAt])
  @@map("b2c_sessions")
}

model B2CChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  text      String   @db.Text
  createdAt DateTime @default(now())

  session B2CSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("b2c_chat_messages")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String             @unique
  plan       SubscriptionPlan   @default(FREE)
  status     SubscriptionStatus @default(ACTIVE)
  expiresAt  DateTime?
  yookassaId String?
  paymentSource String?
  lastPaymentAt DateTime?
  adminNote  String?
  ltvRub     Decimal?           @db.Decimal(12, 2)
  limitOverrides Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]
  billingPeriods BillingPeriod[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  subscriptionId String?
  yookassaId     String?       @unique
  source         PaymentSource @default(YOOKASSA)
  externalId     String?
  adminNote      String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("RUB")
  status         PaymentStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model UserEvent {
  id        String   @id @default(uuid())
  userId    String?
  actorId   String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("user_events")
}

model AIUsage {
  id        String   @id @default(uuid())
  userId    String
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("ai_usage")
}

model AIRequestLog {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  section   String?
  model     String?
  status    String
  isMock    Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@map("ai_request_logs")
}

model BillingPeriod {
  id                       String              @id @default(uuid())
  userId                   String
  subscriptionId           String?
  planCode                 String
  status                   BillingPeriodStatus @default(OPEN)
  periodStart              DateTime
  periodEnd                DateTime
  creditsGranted           Int                 @default(0)
  creditsUsed              Int                 @default(0)
  creditsRemainingSnapshot Int                 @default(0)
  costTotalUsd             Decimal             @default(0) @db.Decimal(18, 8)
  costTotalRub             Decimal             @default(0) @db.Decimal(18, 2)
  metadata                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creditLedgerEntries CreditLedgerEntry[]
  aiGenerations       AIGeneration[]

  @@index([userId, periodStart, periodEnd])
  @@index([subscriptionId])
  @@index([status])
  @@map("billing_periods")
}

model CreditLedgerEntry {
  id              String             @id @default(uuid())
  userId          String
  projectId       String?
  billingPeriodId String?
  type            CreditLedgerType
  source          CreditLedgerSource
  amount          Int
  balanceAfter    Int
  reason          String?
  metadata        Json?
  createdAt       DateTime           @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billingPeriod BillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([billingPeriodId])
  @@index([type])
  @@index([source])
  @@map("credit_ledger")
}

model AIModelPricing {
  id                    String     @id @default(uuid())
  provider              AIProvider
  model                 String
  inputPricePer1M       Decimal    @db.Decimal(18, 8)
  outputPricePer1M      Decimal    @db.Decimal(18, 8)
  cachedInputPricePer1M Decimal?   @db.Decimal(18, 8)
  currency              String     @default("USD")
  validFrom             DateTime
  validTo               DateTime?
  metadata              Json?
  createdAt             DateTime   @default(now())

  @@index([provider, model, validFrom])
  @@index([validTo])
  @@map("ai_model_pricing")
}

model FeaturePricing {
  id              String             @id @default(uuid())
  featureCode     String
  generationClass GenerationClass
  creditPrice     Int
  minCredits      Int                @default(0)
  maxCredits      Int?
  pricingMode     FeaturePricingMode @default(FIXED)
  config          Json?
  isActive        Boolean            @default(true)
  validFrom       DateTime
  validTo         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([featureCode, isActive])
  @@index([generationClass])
  @@index([validFrom, validTo])
  @@map("feature_pricing")
}

model AIGeneration {
  id                String             @id @default(uuid())
  userId            String
  projectId         String?
  billingPeriodId   String?
  workflowRunId     String?
  workflowStepId    String?
  featureCode       String
  featureGroup      String?
  generationClass   GenerationClass
  provider          AIProvider
  model             String
  modelVersion      String?
  status            AIGenerationStatus @default(QUEUED)
  requestHash       String?
  idempotencyKey    String?            @unique
  inputTokens       Int                @default(0)
  outputTokens      Int                @default(0)
  cachedInputTokens Int                @default(0)
  totalTokens       Int                @default(0)
  estimatedCostUsd  Decimal            @default(0) @db.Decimal(18, 8)
  actualCostUsd     Decimal            @default(0) @db.Decimal(18, 8)
  actualCostRub     Decimal            @default(0) @db.Decimal(18, 2)
  creditsReserved   Int                @default(0)
  creditsCharged    Int                @default(0)
  creditsRefunded   Int                @default(0)
  latencyMs         Int?
  retryCount        Int                @default(0)
  errorCode         String?
  errorMessage      String?
  promptVersion     String?
  contextVersion    String?
  pricingSnapshot   Json?
  metadata          Json?
  createdAt         DateTime           @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billingPeriod BillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)
  workflowRun   AIWorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStep  AIWorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  usageEvents   AIUsageEvent[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([billingPeriodId])
  @@index([workflowRunId])
  @@index([workflowStepId])
  @@index([featureCode, createdAt])
  @@index([provider, model, createdAt])
  @@index([status, createdAt])
  @@index([requestHash])
  @@map("ai_generations")
}

model AIUsageEvent {
  id           String           @id @default(uuid())
  userId       String
  projectId    String?
  generationId String?
  eventType    AIUsageEventType
  featureCode  String?
  provider     AIProvider?
  model        String?
  creditsDelta Int              @default(0)
  costUsd      Decimal          @default(0) @db.Decimal(18, 8)
  tokensInput  Int              @default(0)
  tokensOutput Int              @default(0)
  metadata     Json?
  createdAt    DateTime         @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generation AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([generationId])
  @@index([eventType, createdAt])
  @@index([featureCode, createdAt])
  @@map("ai_usage_events")
}

model AIWorkflowRun {
  id          String    @id @default(uuid())
  workflow    String
  featureCode String?
  projectId   String
  userId      String
  status      String    @default("RUNNING")
  input       Json?
  output      Json?
  metadata    Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps       AIWorkflowStep[]
  artifacts   AIArtifact[]
  generations AIGeneration[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([workflow, status])
  @@map("ai_workflow_runs")
}

model AIWorkflowStep {
  id            String    @id @default(uuid())
  workflowRunId String
  step          String
  status        String    @default("RUNNING")
  input         Json?
  output        Json?
  error         String?
  retryCount    Int       @default(0)
  latencyMs     Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workflowRun AIWorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  artifacts   AIArtifact[]
  generations AIGeneration[]

  @@index([workflowRunId, step])
  @@index([status, createdAt])
  @@map("ai_workflow_steps")
}

model AIArtifact {
  id             String   @id @default(uuid())
  type           String
  workflow       String
  step           String?
  projectId      String
  userId         String
  workflowRunId  String?
  workflowStepId String?
  generationId   String?
  title          String?
  content        String
  structured     Json?
  metadata       Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun  AIWorkflowRun?  @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStep AIWorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  structuredOutputs ProjectStructuredOutput[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([workflow, step])
  @@index([type, createdAt])
  @@index([workflowRunId])
  @@index([workflowStepId])
  @@map("ai_artifacts")
}

model ProjectStructuredOutput {
  id         String   @id @default(uuid())
  userId     String
  projectId  String
  artifactId String?
  domain     String
  kind       String
  key        String?
  title      String?
  content    String?
  data       Json
  source     String   @default("ai_artifact")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact AIArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, domain, kind])
  @@index([artifactId])
  @@map("project_structured_outputs")
}

model ProjectFile {
  id           String   @id @default(uuid())
  userId       String
  projectId    String
  originalName String
  mimeType     String?
  sizeBytes    Int
  extension    String?
  textContent  String
  summary      String?
  status       String   @default("ready")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("project_files")
}

model PromptVersion {
  id                 String   @id @default(uuid())
  promptId           String
  versionLabel       String
  workflow           String
  step               String
  featureCode        String
  artifactType       String
  model              String?
  temperature        Decimal? @db.Decimal(4, 2)
  maxTokens          Int?
  systemPrompt       String?
  userPromptTemplate String?
  validationRules    Json?
  status             String   @default("DRAFT")
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  variants  PromptExperimentVariant[]

  @@index([workflow, step, status])
  @@index([promptId, versionLabel])
  @@map("prompt_versions")
}

model PromptExperiment {
  id          String    @id @default(uuid())
  name        String
  workflow    String
  step        String
  status      String    @default("DRAFT")
  trafficPct  Int       @default(100)
  startedAt   DateTime?
  endedAt     DateTime?
  createdById String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  variants  PromptExperimentVariant[]

  @@index([workflow, step, status])
  @@map("prompt_experiments")
}

model PromptExperimentVariant {
  id              String   @id @default(uuid())
  experimentId    String
  promptVersionId String?
  name            String
  trafficWeight   Int      @default(50)
  isControl       Boolean  @default(false)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  experiment    PromptExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion?   @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([experimentId])
  @@index([promptVersionId])
  @@map("prompt_experiment_variants")
}

model FeatureUsageDaily {
  id           String   @id @default(uuid())
  date         String
  userId       String
  projectId    String?
  featureCode  String
  count        Int      @default(0)
  successCount Int      @default(0)
  failCount    Int      @default(0)
  creditsUsed  Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(18, 8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([date, userId, projectId, featureCode])
  @@index([date, userId])
  @@index([date, projectId])
  @@index([date, featureCode])
  @@map("feature_usage_daily")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id                  String        @id @default(uuid())
  userId              String
  name                String
  niche               String?
  description         String?
  status              ProjectStatus @default(DRAFT)
  strategySummary     String?
  strategyData        Json?
  strategyCompletedAt DateTime?
  utpData             Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jtbdSessions        JTBDSession[]
  audienceAvatars     AudienceAvatar[]
  products            Product[]
  generatedTexts      GeneratedText[]
  contentPlanItems    ContentPlanItem[]
  creditLedgerEntries CreditLedgerEntry[]
  aiGenerations       AIGeneration[]
  aiUsageEvents       AIUsageEvent[]
  featureUsageDaily   FeatureUsageDaily[]
  aiWorkflowRuns      AIWorkflowRun[]
  aiArtifacts         AIArtifact[]
  structuredOutputs   ProjectStructuredOutput[]
  projectFiles        ProjectFile[]
  tasks               ProjectTask[]
  castDevRecords      CastDevRecord[]

  @@index([userId, createdAt])
  @@map("projects")
}

model ProjectTask {
  id              String   @id @default(uuid())
  projectId       String
  userId          String
  title           String
  description     String?
  category        String
  priority        String
  status          String   @default("backlog")
  dueBucket       String   @default("backlog")
  route           String?
  taskKey         String?  @map("key")
  sortOrder       Int      @default(0)
  source          String?
  taskPlanVersion String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, taskPlanVersion, sortOrder])
  @@index([projectId, source, taskPlanVersion, taskKey])
  @@index([projectId, status, sortOrder])
  @@index([projectId, dueBucket, sortOrder])
  @@index([userId, createdAt])
  @@map("project_tasks")
}

model JTBDSession {
  id          String            @id @default(uuid())
  projectId   String
  title       String?
  status      JTBDSessionStatus @default(DRAFT)
  currentStep Int               @default(1)
  answers     Json?
  summary     String?
  finalJob    String?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  products       Product[]
  generatedTexts GeneratedText[]

  @@index([projectId, createdAt])
  @@map("jtbd_sessions")
}

model AudienceAvatar {
  id             String   @id @default(uuid())
  projectId      String
  name           String
  segment        String?
  subsegment     String?
  profileSummary String?
  pains          Json?
  desires        Json?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  products       Product[]
  generatedTexts GeneratedText[]

  @@index([projectId, createdAt])
  @@map("audience_avatars")
}

model Product {
  id               String      @id @default(uuid())
  projectId        String
  jtbdSessionId    String?
  audienceAvatarId String?
  type             ProductType
  title            String
  format           String?
  shortDescription String?
  transformation   String?
  offer            String?
  priceText        String?
  isAiGenerated    Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jtbdSession    JTBDSession?    @relation(fields: [jtbdSessionId], references: [id], onDelete: SetNull)
  audienceAvatar AudienceAvatar? @relation(fields: [audienceAvatarId], references: [id], onDelete: SetNull)
  generatedTexts GeneratedText[]

  @@index([projectId, type])
  @@map("products")
}

model GeneratedText {
  id               String            @id @default(uuid())
  projectId        String
  productId        String?
  jtbdSessionId    String?
  audienceAvatarId String?
  type             GeneratedTextType
  title            String?
  prompt           String?
  content          String
  provider         String?
  isMock           Boolean           @default(false)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  jtbdSession    JTBDSession?    @relation(fields: [jtbdSessionId], references: [id], onDelete: SetNull)
  audienceAvatar AudienceAvatar? @relation(fields: [audienceAvatarId], references: [id], onDelete: SetNull)

  @@index([projectId, type, createdAt])
  @@map("generated_texts")
}

model CastDevRecord {
  id           String   @id @default(uuid())
  userId       String
  projectId    String
  title        String
  sourceUrl    String
  sourceType   String   @default("google_drive")
  fileName     String?
  mimeType     String?
  durationSec  Int?
  status       String   @default("pending")
  transcriptText String?
  transcriptFormatted String?
  analysis     Json?
  metadata     Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId, createdAt])
  @@index([projectId, status])
  @@map("cast_dev_records")
}

model ContentPlanItem {
  id        String   @id @default(uuid())
  projectId String
  type      String
  title     String
  content   String?
  platform  String?
  status    String   @default("draft")
  date      String
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
  @@map("content_plan_items")
}


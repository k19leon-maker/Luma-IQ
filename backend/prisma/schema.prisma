generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?
  name                  String?
  avatarUrl             String?
  googleId              String?   @unique
  role                  Role      @default(USER)
  isVerified            Boolean   @default(false)
  avatarColor           String?   @default("#7c6cfc")
  defaultAiModel        String?   @default("chatgpt")
  specialization        String?
  onboardingStatus      String    @default("not_started")
  onboardingStep        Int       @default(0)
  onboardingVersion     String    @default("b2b_v1")
  onboardingCompletedAt DateTime?
  onboardingData        Json?
  recommendedRoute      String?
  createdProjectId      String?
  archivedAt            DateTime?
  archivedById          String?
  archiveReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  refreshTokens            RefreshToken[]
  sessions                 Session[]
  projects                 Project[]
  verificationTokens       VerificationToken[]
  subscription             Subscription?
  payments                 Payment[]
  aiUsage                  AIUsage[]
  events                   UserEvent[]
  aiRequestLogs            AIRequestLog[]
  billingPeriods           BillingPeriod[]
  creditLedgerEntries      CreditLedgerEntry[]
  aiGenerations            AIGeneration[]
  aiUsageEvents            AIUsageEvent[]
  featureUsageDaily        FeatureUsageDaily[]
  aiWorkflowRuns           AIWorkflowRun[]
  aiArtifacts              AIArtifact[]
  aiContextSummaries       AIContextSummary[]
  aiBatchJobs              AIBatchJob[]
  structuredOutputs        ProjectStructuredOutput[]
  projectFiles             ProjectFile[]
  projectTasks             ProjectTask[]
  castDevRecords           CastDevRecord[]
  caseStudies              CaseStudy[]
  caseStudyImports         CaseStudyImport[]
  promptVersions           PromptVersion[]
  promptExperiments        PromptExperiment[]
  consentLogs              ConsentLog[]
  activatedCheckoutIntents CheckoutIntent[]
  telegramBots             TelegramBot[]
  botScenarios             BotScenario[]
  botScenarioVersions      BotScenarioVersion[]
  botSubscribers           BotSubscriber[]
  botTags                  BotTag[]
  botScenarioEnrollments   BotScenarioEnrollment[]
  botMessageDeliveries     BotMessageDelivery[]
  botInboundUpdates        BotInboundUpdate[]
  botEvents                BotEvent[]
  botAssets                BotAsset[]

  @@index([archivedAt])
  @@map("users")
}

model ConsentLog {
  id                   String   @id @default(uuid())
  userId               String?
  email                String?
  ip                   String?
  userAgent            String?
  privacyAccepted      Boolean  @default(false)
  personalDataAccepted Boolean  @default(false)
  offerAccepted        Boolean  @default(false)
  documentVersion      String
  source               String?
  acceptedAt           DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, acceptedAt])
  @@index([email, acceptedAt])
  @@index([documentVersion])
  @@map("consent_logs")
}

model B2CSession {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  email             String?
  phone             String?
  profile           Json?
  diagnosticAnswers Json?
  clientData        Json?
  expiresAt         DateTime
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages B2CChatMessage[]

  @@index([expiresAt])
  @@index([email, updatedAt])
  @@map("b2c_sessions")
}

model B2CChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  text      String   @db.Text
  createdAt DateTime @default(now())

  session B2CSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("b2c_chat_messages")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Subscription {
  id             String             @id @default(uuid())
  userId         String             @unique
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  expiresAt      DateTime?
  yookassaId     String?
  paymentSource  String?
  lastPaymentAt  DateTime?
  adminNote      String?
  ltvRub         Decimal?           @db.Decimal(12, 2)
  limitOverrides Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]
  billingPeriods BillingPeriod[]

  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  subscriptionId   String?
  yookassaId       String?       @unique
  source           PaymentSource @default(YOOKASSA)
  externalId       String?
  adminNote        String?
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("RUB")
  status           PaymentStatus @default(PENDING)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  checkoutIntentId String?       @unique

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  checkoutIntent CheckoutIntent? @relation(fields: [checkoutIntentId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model CheckoutIntent {
  id                   String               @id @default(uuid())
  orderId              String               @unique
  sessionTokenHash     String               @unique
  csrfTokenHash        String
  idempotencyKey       String               @unique
  status               CheckoutIntentStatus @default(PENDING)
  email                String
  emailHash            String
  name                 String?
  planCode             String
  amount               Decimal              @db.Decimal(10, 2)
  currency             String               @default("RUB")
  pricingSnapshot      Json
  consentSnapshot      Json
  legalDocumentVersion String
  consentAcceptedAt    DateTime
  attribution          Json?
  anonymousSessionId   String?
  landingPath          String?
  referrer             String?
  activatedUserId      String?
  paidAt               DateTime?
  accountActivatedAt   DateTime?
  failureCode          String?
  failureMessage       String?
  expiresAt            DateTime
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  activatedUser   User?                    @relation(fields: [activatedUserId], references: [id], onDelete: SetNull)
  paymentAttempts CheckoutPaymentAttempt[]
  payment         Payment?

  @@index([emailHash, createdAt])
  @@index([status, expiresAt])
  @@index([activatedUserId])
  @@map("checkout_intents")
}

model CheckoutPaymentAttempt {
  id                     String                       @id @default(uuid())
  checkoutIntentId       String
  status                 CheckoutPaymentAttemptStatus @default(CREATED)
  provider               String                       @default("YOOKASSA")
  providerPaymentId      String?                      @unique
  providerIdempotencyKey String                       @unique
  amount                 Decimal                      @db.Decimal(10, 2)
  currency               String                       @default("RUB")
  confirmationUrl        String?
  errorCode              String?
  providerStatus         String?
  metadata               Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  checkoutIntent CheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)

  @@index([checkoutIntentId, createdAt])
  @@index([status, updatedAt])
  @@map("checkout_payment_attempts")
}

model UserEvent {
  id        String   @id @default(uuid())
  userId    String?
  actorId   String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("user_events")
}

model AIUsage {
  id        String   @id @default(uuid())
  userId    String
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("ai_usage")
}

model AIRequestLog {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  section   String?
  model     String?
  status    String
  isMock    Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@map("ai_request_logs")
}

model BillingPeriod {
  id                       String              @id @default(uuid())
  userId                   String
  subscriptionId           String?
  planCode                 String
  status                   BillingPeriodStatus @default(OPEN)
  periodStart              DateTime
  periodEnd                DateTime
  creditsGranted           Int                 @default(0)
  creditsUsed              Int                 @default(0)
  creditsRemainingSnapshot Int                 @default(0)
  costTotalUsd             Decimal             @default(0) @db.Decimal(18, 8)
  costTotalRub             Decimal             @default(0) @db.Decimal(18, 2)
  metadata                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creditLedgerEntries CreditLedgerEntry[]
  aiGenerations       AIGeneration[]

  @@index([userId, periodStart, periodEnd])
  @@index([subscriptionId])
  @@index([status])
  @@map("billing_periods")
}

model CreditLedgerEntry {
  id              String             @id @default(uuid())
  userId          String
  projectId       String?
  billingPeriodId String?
  generationId    String?
  type            CreditLedgerType
  source          CreditLedgerSource
  unit            CreditLedgerUnit   @default(LEGACY_CREDIT)
  amount          Int
  quantity        Int                @default(0)
  balanceBefore   Int                @default(0)
  balanceAfter    Int
  reservedAfter   Int                @default(0)
  availableAfter  Int                @default(0)
  actionKey       String?
  idempotencyKey  String?
  settledAt       DateTime?
  expiresAt       DateTime?
  reason          String?
  metadata        Json?
  createdAt       DateTime           @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billingPeriod BillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)
  generation    AIGeneration?  @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([unit, generationId, type])
  @@unique([userId, unit, idempotencyKey, type])
  @@index([userId, createdAt])
  @@index([userId, billingPeriodId, unit, createdAt])
  @@index([projectId, createdAt])
  @@index([billingPeriodId])
  @@index([generationId])
  @@index([type])
  @@index([source])
  @@index([expiresAt])
  @@map("credit_ledger")
}

model AIModelPricing {
  id                    String     @id @default(uuid())
  provider              AIProvider
  model                 String
  inputPricePer1M       Decimal    @db.Decimal(18, 8)
  outputPricePer1M      Decimal    @db.Decimal(18, 8)
  cachedInputPricePer1M Decimal?   @db.Decimal(18, 8)
  audioInputPricePer1M  Decimal?   @db.Decimal(18, 8)
  audioOutputPricePer1M Decimal?   @db.Decimal(18, 8)
  currency              String     @default("USD")
  validFrom             DateTime
  validTo               DateTime?
  metadata              Json?
  createdAt             DateTime   @default(now())

  @@index([provider, model, validFrom])
  @@index([validTo])
  @@map("ai_model_pricing")
}

model AIModelProfileVersion {
  id            String     @id @default(uuid())
  alias         String
  provider      AIProvider
  actualModelId String
  isActive      Boolean    @default(true)
  validFrom     DateTime
  validTo       DateTime?
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([alias, isActive, validFrom])
  @@index([provider, actualModelId])
  @@map("ai_model_profile_versions")
}

model AIActionDefinitionVersion {
  id             String    @id @default(uuid())
  actionKey      String
  pipeline       Json
  contextBudget  Int
  outputLimit    Int
  retryPolicy    Json
  fallbackPolicy Json
  batchEligible  Boolean   @default(false)
  isActive       Boolean   @default(true)
  validFrom      DateTime
  validTo        DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([actionKey, isActive, validFrom])
  @@map("ai_action_definition_versions")
}

model AIActionPricingVersion {
  id        String    @id @default(uuid())
  actionKey String
  aiPoints  Int
  isActive  Boolean   @default(true)
  validFrom DateTime
  validTo   DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([actionKey, isActive, validFrom])
  @@map("ai_action_pricing_versions")
}

model AIFeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_feature_flags")
}

model AIConfigurationAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  configType  String
  configKey   String
  operation   String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([configType, configKey, createdAt])
  @@index([actorUserId, createdAt])
  @@map("ai_configuration_audit_logs")
}

model PlanCatalogOverride {
  id                  String   @id @default(uuid())
  code                String   @unique
  isPublic            Boolean?
  isPurchasable       Boolean?
  displayOrder        Int?
  shortDescription    String?
  extendedDescription String?
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("plan_catalog_overrides")
}

model FeaturePricing {
  id              String             @id @default(uuid())
  featureCode     String
  generationClass GenerationClass
  creditPrice     Int
  minCredits      Int                @default(0)
  maxCredits      Int?
  pricingMode     FeaturePricingMode @default(FIXED)
  config          Json?
  isActive        Boolean            @default(true)
  validFrom       DateTime
  validTo         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([featureCode, isActive])
  @@index([generationClass])
  @@index([validFrom, validTo])
  @@map("feature_pricing")
}

model AIGeneration {
  id                String             @id @default(uuid())
  userId            String
  projectId         String?
  billingPeriodId   String?
  workflowRunId     String?
  workflowStepId    String?
  featureCode       String
  featureGroup      String?
  generationClass   GenerationClass
  provider          AIProvider
  model             String
  modelVersion      String?
  status            AIGenerationStatus @default(QUEUED)
  requestHash       String?
  idempotencyKey    String?            @unique
  inputTokens       Int                @default(0)
  outputTokens      Int                @default(0)
  cachedInputTokens Int                @default(0)
  reasoningTokens   Int                @default(0)
  audioInputTokens  Int                @default(0)
  audioOutputTokens Int                @default(0)
  totalTokens       Int                @default(0)
  estimatedCostUsd  Decimal            @default(0) @db.Decimal(18, 8)
  actualCostUsd     Decimal            @default(0) @db.Decimal(18, 8)
  actualCostRub     Decimal            @default(0) @db.Decimal(18, 2)
  creditsReserved   Int                @default(0)
  creditsCharged    Int                @default(0)
  creditsRefunded   Int                @default(0)
  aiPointsReserved  Int                @default(0)
  aiPointsCaptured  Int                @default(0)
  aiPointsRefunded  Int                @default(0)
  latencyMs         Int?
  retryCount        Int                @default(0)
  errorCode         String?
  errorMessage      String?
  promptVersion     String?
  contextVersion    String?
  pricingSnapshot   Json?
  metadata          Json?
  createdAt         DateTime           @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billingPeriod BillingPeriod?      @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)
  workflowRun   AIWorkflowRun?      @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStep  AIWorkflowStep?     @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  usageEvents   AIUsageEvent[]
  providerCalls AIProviderCall[]
  ledgerEntries CreditLedgerEntry[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([billingPeriodId])
  @@index([workflowRunId])
  @@index([workflowStepId])
  @@index([featureCode, createdAt])
  @@index([provider, model, createdAt])
  @@index([status, createdAt])
  @@index([requestHash])
  @@map("ai_generations")
}

model AIUsageEvent {
  id           String           @id @default(uuid())
  userId       String
  projectId    String?
  generationId String?
  eventType    AIUsageEventType
  featureCode  String?
  provider     AIProvider?
  model        String?
  creditsDelta Int              @default(0)
  costUsd      Decimal          @default(0) @db.Decimal(18, 8)
  tokensInput  Int              @default(0)
  tokensOutput Int              @default(0)
  metadata     Json?
  createdAt    DateTime         @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generation AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([generationId])
  @@index([eventType, createdAt])
  @@index([featureCode, createdAt])
  @@map("ai_usage_events")
}

model AIProviderCall {
  id                String     @id @default(uuid())
  generationId      String?
  workflowRunId     String?
  workflowStepId    String?
  userId            String?
  projectId         String?
  correlationId     String?
  responseId        String?
  provider          AIProvider
  modelAlias        String?
  actualModelId     String
  modelSnapshot     Json?
  promptVersion     String?
  actionKey         String
  pipeline          String?
  stage             String
  status            String     @default("RUNNING")
  inputTokens       Int        @default(0)
  cachedInputTokens Int        @default(0)
  outputTokens      Int        @default(0)
  reasoningTokens   Int        @default(0)
  audioInputTokens  Int        @default(0)
  audioOutputTokens Int        @default(0)
  latencyMs         Int?
  retryIndex        Int        @default(0)
  isBatch           Boolean    @default(false)
  costUsd           Decimal    @default(0) @db.Decimal(18, 8)
  pricingSnapshot   Json?
  errorCode         String?
  errorMessage      String?
  metadata          Json?
  startedAt         DateTime   @default(now())
  finishedAt        DateTime?
  createdAt         DateTime   @default(now())

  generation AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([generationId, createdAt])
  @@index([workflowRunId, workflowStepId])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([correlationId, createdAt])
  @@index([actionKey, stage, createdAt])
  @@index([provider, actualModelId, createdAt])
  @@index([status, createdAt])
  @@index([responseId])
  @@map("ai_provider_calls")
}

model AIBatchJob {
  id              String     @id @default(uuid())
  userId          String
  projectId       String
  actionKey       String
  featureCode     String
  workflow        String
  step            String
  status          String     @default("queued")
  idempotencyKey  String     @unique
  provider        AIProvider @default(OPENAI)
  providerBatchId String?    @unique
  inputFileId     String?
  outputFileId    String?
  errorFileId     String?
  totalItems      Int
  completedItems  Int        @default(0)
  failedItems     Int        @default(0)
  metadata        Json?
  errorMessage    String?
  submittedAt     DateTime?
  inProgressAt    DateTime?
  finalizingAt    DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  expiredAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   AIBatchItem[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, updatedAt])
  @@index([actionKey, createdAt])
  @@map("ai_batch_jobs")
}

model AIBatchItem {
  id                String    @id @default(uuid())
  batchJobId        String
  customId          String
  position          Int
  status            String    @default("queued")
  input             Json
  output            Json?
  error             Json?
  generationId      String?   @unique
  artifactId        String?
  aiPoints          Int
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  cachedInputTokens Int       @default(0)
  reasoningTokens   Int       @default(0)
  costUsd           Decimal   @default(0) @db.Decimal(18, 8)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batchJob AIBatchJob @relation(fields: [batchJobId], references: [id], onDelete: Cascade)

  @@unique([batchJobId, customId])
  @@index([batchJobId, position])
  @@index([status, updatedAt])
  @@index([generationId])
  @@map("ai_batch_items")
}

model AIWorkflowRun {
  id          String    @id @default(uuid())
  workflow    String
  featureCode String?
  projectId   String
  userId      String
  status      String    @default("RUNNING")
  input       Json?
  output      Json?
  metadata    Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps               AIWorkflowStep[]
  artifacts           AIArtifact[]
  generations         AIGeneration[]
  botScenarioVersions BotScenarioVersion[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([workflow, status])
  @@map("ai_workflow_runs")
}

model AIWorkflowStep {
  id            String    @id @default(uuid())
  workflowRunId String
  step          String
  status        String    @default("RUNNING")
  input         Json?
  output        Json?
  error         String?
  retryCount    Int       @default(0)
  latencyMs     Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workflowRun AIWorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  artifacts   AIArtifact[]
  generations AIGeneration[]

  @@index([workflowRunId, step])
  @@index([status, createdAt])
  @@map("ai_workflow_steps")
}

model AIArtifact {
  id             String   @id @default(uuid())
  type           String
  workflow       String
  step           String?
  projectId      String
  userId         String
  workflowRunId  String?
  workflowStepId String?
  generationId   String?
  title          String?
  content        String
  structured     Json?
  metadata       Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun         AIWorkflowRun?            @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStep        AIWorkflowStep?           @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  structuredOutputs   ProjectStructuredOutput[]
  botScenarioVersions BotScenarioVersion[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([workflow, step])
  @@index([type, createdAt])
  @@index([workflowRunId])
  @@index([workflowStepId])
  @@map("ai_artifacts")
}

model ProjectStructuredOutput {
  id         String   @id @default(uuid())
  userId     String
  projectId  String
  artifactId String?
  domain     String
  kind       String
  key        String?
  title      String?
  content    String?
  data       Json
  source     String   @default("ai_artifact")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
